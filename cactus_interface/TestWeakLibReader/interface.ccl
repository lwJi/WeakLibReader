# Interface definition for thorn TestWeakLibReader

IMPLEMENTS: TestWeakLibReader

USES INCLUDE HEADER: loop_device.hxx

CCTK_REAL energy TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "weaklibreader test"
CCTK_REAL opacity_emab TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "EmAb opacity test"
CCTK_REAL opacity_iso TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Iso opacity test"
CCTK_REAL eos_log_eta TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "log10(mu_e/(kB*T))"
CCTK_REAL eos_dxp TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "D*Xp for Brem"
CCTK_REAL eos_dxn TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "D*Xn for Brem"
CCTK_REAL eos_dxpn TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "D*sqrt(Xp*Xn) for Brem"
CCTK_REAL opacity_nes TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "NES kernel test"
CCTK_REAL opacity_pair TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Pair kernel test"
CCTK_REAL opacity_brem TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Brem kernel test"
CCTK_REAL eos_inv_temp TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Recovered T from inversion"
CCTK_REAL eos_inv_error TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Inversion error code"

CCTK_REAL opacity_emab_anue TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "EmAb opacity species=1 (anue)"
CCTK_REAL eos_inv_temp_p TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Recovered T from pressure inversion"
CCTK_REAL eos_inv_error_p TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Pressure inversion error code"
CCTK_REAL eos_inv_temp_s TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Recovered T from entropy inversion"
CCTK_REAL eos_inv_error_s TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Entropy inversion error code"
CCTK_REAL eos_inv_temp_g TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Recovered T from energy inversion (with guess)"
CCTK_REAL eos_inv_error_g TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Energy inversion with guess error code"
CCTK_REAL opacity_nes_offdiag TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "NES off-diagonal energy pair"
CCTK_REAL opacity_pair_offdiag TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "Pair off-diagonal energy pair"
CCTK_REAL opacity_emab_sweep TYPE=GF CENTERING={VVV} TAGS="checkpoint='yes'" "EmAb energy sweep sum"
